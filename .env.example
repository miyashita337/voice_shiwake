# AssemblyAI ASR + Diarization
# https://www.assemblyai.com/dashboard/signup ($50無料枠あり)
ASSEMBLYAI_API_KEY=your_assemblyai_key_here

# Anthropic Claude API (議事録整形)
# https://console.anthropic.com/
ANTHROPIC_API_KEY=your_claude_key_here

# --- Slack 投稿 (2方式どちらか) ---

# 方式A: Incoming Webhook（フラット投稿のみ、スレッド化不可）
# https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# 方式B: Bot Token（スレッド化可、議事録さんと同じ方式、推奨）
# https://api.slack.com/apps → OAuth & Permissions → Bot Token Scopes: chat:write
# Bot を投稿先 channel に invite してください
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_ID=C0ADDPUUAAE

# 任意: 議事録投稿先チャンネル名表示用
SLACK_CHANNEL_LABEL=#meeting-minutes

# 任意: Resemblyzer声紋DB の保存先
VOICEPRINT_DB_PATH=./voiceprints.sqlite3

# 任意: 話者照合のcos類似度閾値（0.0〜1.0、これ未満は[Unknown]）
VOICEPRINT_THRESHOLD=0.75

# 任意: Claude モデル名
CLAUDE_MODEL=claude-sonnet-4-6

# 任意: videodb（過去議事録の意味検索を使う場合）
# https://console.videodb.io/ で取得
VIDEODB_API_KEY=
